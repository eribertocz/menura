{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh pr review --approve *)",
      "Bash(gh release *)",
      "Bash(gh repo *)",
      "Bash(gh ruleset *)",
      "Bash(gh label *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh workflow *)",
      "Bash(gh api *)",
      "Bash(git tag *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main *)",
      "Bash(git push * --tags *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main*)",
      "Bash(git push *:refs/heads/main*)",
      "Bash(git push * +*)",
      "Bash(git push --mirror *)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git push origin main)",
      "Bash(gh pr merge)",
      "Bash(gh pr review --approve)"
    ]
  }
}
