{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eribertocz.github.io/menura/spec/contracts/model-description/1.3.0",
  "title": "Model description document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "contract_version",
    "model_hash",
    "security_fingerprint",
    "datasets",
    "metrics"
  ],
  "properties": {
    "contract": {
      "enum": [
        "menura.model_description",
        "semantic_compiler.model_description"
      ]
    },
    "contract_version": {
      "$ref": "#/$defs/semver"
    },
    "model_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "security_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "fields"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reference",
                "logical_type",
                "is_time",
                "time_grains"
              ],
              "properties": {
                "reference": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "logical_type": {
                  "$ref": "#/$defs/logical_type"
                },
                "is_time": {
                  "type": "boolean"
                },
                "time_grains": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "day",
                      "week",
                      "month",
                      "quarter",
                      "year"
                    ]
                  }
                },
                "ai_context": {}
              }
            }
          },
          "ai_context": {},
          "sql_metrics": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "logical_type",
          "kind",
          "reachable_datasets"
        ],
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "logical_type": {
            "$ref": "#/$defs/logical_type"
          },
          "kind": {
            "enum": [
              "base",
              "derived",
              "context"
            ]
          },
          "reachable_datasets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "ai_context": {}
        }
      }
    },
    "ambiguous_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "paths"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiler_version",
        "slice_version",
        "ossie",
        "contracts",
        "dialects",
        "query_forms",
        "extensions",
        "functions",
        "limits"
      ],
      "properties": {
        "compiler_version": {
          "$ref": "#/$defs/semver"
        },
        "slice_version": {
          "$ref": "#/$defs/semver"
        },
        "ossie": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "normative",
            "tracked_commit",
            "formats"
          ],
          "properties": {
            "normative": {
              "type": "string",
              "minLength": 1
            },
            "tracked_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{7,40}$"
            },
            "formats": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "development",
                  "release"
                ]
              }
            }
          }
        },
        "contracts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contract",
              "version"
            ],
            "properties": {
              "contract": {
                "type": "string",
                "pattern": "^menura\\.[a-z][a-z_]*$"
              },
              "version": {
                "$ref": "#/$defs/semver"
              }
            }
          }
        },
        "dialects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "query_forms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "sql",
              "wide_table"
            ]
          }
        },
        "extensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "versions"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "versions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "functions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "compile",
              "describe",
              "explain",
              "integrity_checks",
              "load",
              "migrate",
              "validate",
              "with_state"
            ]
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_identifier_length",
            "max_decimal_precision"
          ],
          "properties": {
            "max_identifier_length": {
              "type": "integer",
              "minimum": 1
            },
            "max_decimal_precision": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "logical_type": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "boolean",
                "text",
                "date",
                "time",
                "interval",
                "binary",
                "uuid",
                "unsupported"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "bits",
            "signed"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "integer"
            },
            "bits": {
              "enum": [
                8,
                16,
                32,
                64,
                128
              ]
            },
            "signed": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "precision",
            "scale"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "decimal"
            },
            "precision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 38
            },
            "scale": {
              "type": "integer",
              "minimum": 0,
              "maximum": 38
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "bits"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "float"
            },
            "bits": {
              "enum": [
                32,
                64
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "precision",
            "with_time_zone"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "timestamp"
            },
            "precision": {
              "enum": [
                "s",
                "ms",
                "us",
                "ns"
              ]
            },
            "with_time_zone": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "element"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "list"
            },
            "element": {
              "$ref": "#/$defs/logical_type"
            }
          }
        }
      ]
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "ai_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "source",
        "trust"
      ],
      "properties": {
        "value": {},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pointer",
            "model_hash"
          ],
          "properties": {
            "pointer": {
              "type": "string",
              "pattern": "^(/([^~/]|~[01])*)+$"
            },
            "model_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "trust": {
          "enum": [
            "untrusted_model_content"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "$comment": "Contract versions 1.0 and 1.1 carried ai_context as any JSON value; from 1.2.0 it carries its provenance and trust label (DSC-3.6).",
      "if": {
        "required": [
          "contract_version"
        ],
        "properties": {
          "contract_version": {
            "type": "string",
            "pattern": "^1\\.[01]\\."
          }
        }
      },
      "else": {
        "properties": {
          "datasets": {
            "items": {
              "properties": {
                "ai_context": {
                  "$ref": "#/$defs/ai_context"
                },
                "fields": {
                  "items": {
                    "properties": {
                      "ai_context": {
                        "$ref": "#/$defs/ai_context"
                      }
                    }
                  }
                }
              }
            }
          },
          "metrics": {
            "items": {
              "properties": {
                "ai_context": {
                  "$ref": "#/$defs/ai_context"
                }
              }
            }
          }
        }
      }
    }
  ]
}
