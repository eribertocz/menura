{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://menura.invalid/spec/contracts/model-description/1.1.0",
  "title": "Model description document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "contract_version",
    "model_hash",
    "security_fingerprint",
    "datasets",
    "metrics"
  ],
  "properties": {
    "contract": {
      "enum": ["menura.model_description", "semantic_compiler.model_description"]
    },
    "contract_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "model_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "security_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "fields"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reference",
                "logical_type",
                "is_time",
                "time_grains"
              ],
              "properties": {
                "reference": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "logical_type": {
                  "$ref": "#/$defs/logical_type"
                },
                "is_time": {
                  "type": "boolean"
                },
                "time_grains": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "day",
                      "week",
                      "month",
                      "quarter",
                      "year"
                    ]
                  }
                },
                "ai_context": {}
              }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "logical_type",
          "kind",
          "reachable_datasets"
        ],
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "logical_type": {
            "$ref": "#/$defs/logical_type"
          },
          "kind": {
            "enum": [
              "base",
              "derived",
              "context"
            ]
          },
          "reachable_datasets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "ai_context": {}
        }
      }
    },
    "ambiguous_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "paths"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "logical_type": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "boolean",
                "text",
                "date",
                "time",
                "interval",
                "binary",
                "uuid",
                "unsupported"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "bits",
            "signed"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "integer"
            },
            "bits": {
              "enum": [
                8,
                16,
                32,
                64,
                128
              ]
            },
            "signed": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "precision",
            "scale"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "decimal"
            },
            "precision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 38
            },
            "scale": {
              "type": "integer",
              "minimum": 0,
              "maximum": 38
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "bits"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "float"
            },
            "bits": {
              "enum": [
                32,
                64
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "precision",
            "with_time_zone"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "timestamp"
            },
            "precision": {
              "enum": [
                "s",
                "ms",
                "us",
                "ns"
              ]
            },
            "with_time_zone": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "element"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "list"
            },
            "element": {
              "$ref": "#/$defs/logical_type"
            }
          }
        }
      ]
    }
  }
}