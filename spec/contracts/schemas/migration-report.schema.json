{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eribertocz.github.io/menura/spec/contracts/migration-report/1.0.0",
  "title": "Migration report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "contract_version",
    "producer",
    "changes",
    "model"
  ],
  "properties": {
    "contract": {
      "const": "menura.migration_report"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "producer": {
      "type": "object",
      "required": [
        "compiler_version",
        "ossie_normative",
        "ossie_tracked_commit",
        "tzdata_version"
      ],
      "additionalProperties": false,
      "properties": {
        "compiler_version": {
          "$ref": "#/$defs/semver"
        },
        "ossie_normative": {
          "type": "string",
          "minLength": 1
        },
        "ossie_tracked_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "tzdata_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pointer",
          "rule",
          "from",
          "to"
        ],
        "properties": {
          "pointer": {
            "type": "string",
            "pattern": "^(/[^/]*)+$"
          },
          "rule": {
            "enum": [
              "MIG-3.2a"
            ]
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "model": {
      "type": "object"
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    }
  }
}
