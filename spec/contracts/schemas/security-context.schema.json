{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eribertocz.github.io/menura/spec/contracts/security-context/1.1.0",
  "title": "Security context document",
  "type": "object",
  "required": [
    "contract",
    "contract_version",
    "subject",
    "roles",
    "attributes"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "oneOf": [
        {"const": "menura.security_context"},
        {"const": "semantic_compiler.security_context"}
      ]
    },
    "contract_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "roles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/value"
      }
    }
  },
  "$defs": {
    "scalar": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "boolean"
        }
      ]
    },
    "value": {
      "oneOf": [
        {
          "$ref": "#/$defs/scalar"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scalar"
          }
        }
      ]
    }
  }
}