{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://menura.invalid/spec/contracts/compiled-plan/1.1.0",
  "title": "Compiled plan document",
  "type": "object",
  "required": [
    "contract",
    "contract_version",
    "producer",
    "dialect",
    "data_source",
    "sql",
    "parameters",
    "result_schema",
    "cache_key",
    "limits",
    "lineage",
    "explanation",
    "warnings"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "enum": ["menura.compiled_plan", "menura.explanation", "semantic_compiler.compiled_plan", "semantic_compiler.explanation"]
    },
    "contract_version": {
      "$ref": "#/$defs/semver"
    },
    "producer": {
      "type": "object",
      "required": [
        "compiler_version",
        "ossie_normative",
        "ossie_tracked_commit",
        "tzdata_version"
      ],
      "additionalProperties": false,
      "properties": {
        "compiler_version": {
          "$ref": "#/$defs/semver"
        },
        "ossie_normative": {
          "type": "string",
          "minLength": 1
        },
        "ossie_tracked_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "tzdata_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dialect": {
      "enum": [
        "duckdb"
      ]
    },
    "data_source": {
      "type": "string",
      "minLength": 1
    },
    "sql": {
      "type": "string"
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "position",
          "logical_type",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "position": {
            "type": "integer",
            "minimum": 1
          },
          "logical_type": {
            "$ref": "#/$defs/logical_type"
          },
          "value": {}
        }
      }
    },
    "result_schema": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "role",
          "logical_type",
          "physical_type",
          "nullable"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "dimension",
              "metric"
            ]
          },
          "logical_type": {
            "$ref": "#/$defs/logical_type"
          },
          "physical_type": {
            "type": "string",
            "minLength": 1
          },
          "nullable": {
            "type": "boolean"
          }
        }
      }
    },
    "cache_key": {
      "type": "object",
      "required": [
        "key",
        "plan_hash",
        "security_fingerprint",
        "data_versions"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/sha256"
        },
        "plan_hash": {
          "$ref": "#/$defs/sha256"
        },
        "security_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "data_versions": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "required": [
              "source",
              "period",
              "version"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string"
              },
              "period": {
                "type": "string"
              },
              "version": {
                "type": "object",
                "required": [
                  "origin",
                  "snapshot"
                ],
                "additionalProperties": false,
                "properties": {
                  "origin": {
                    "type": "string"
                  },
                  "snapshot": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "timeout_ms",
        "max_rows"
      ],
      "additionalProperties": false,
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "max_rows": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "output",
          "model_inputs",
          "physical_inputs",
          "summary",
          "security_policies"
        ],
        "additionalProperties": false,
        "properties": {
          "output": {
            "type": "string"
          },
          "model_inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "physical_inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source",
                "column"
              ],
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": "string"
                },
                "column": {
                  "type": "string"
                }
              }
            }
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "security_policies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "explanation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "step",
          "decision",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "step": {
            "enum": [
              "E1",
              "E2",
              "E3",
              "E4",
              "E5",
              "E6"
            ]
          },
          "decision": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "code",
        "message",
        "location"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^(E|W)[A-Z0-9_-]+$"
        },
        "message": {
          "type": "string"
        },
        "location": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "document",
            "pointer"
          ],
          "additionalProperties": false,
          "properties": {
            "document": {
              "enum": [
                "model",
                "catalog_schema",
                "catalog_state",
                "query",
                "security_context"
              ]
            },
            "pointer": {
              "type": "string"
            },
            "line": {
              "type": "integer",
              "minimum": 1
            },
            "column": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "logical_type": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "boolean",
                "text",
                "date",
                "time",
                "interval",
                "binary",
                "uuid",
                "unsupported"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "bits",
            "signed"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "integer"
            },
            "bits": {
              "enum": [
                8,
                16,
                32,
                64,
                128
              ]
            },
            "signed": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "precision",
            "scale"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "decimal"
            },
            "precision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 38
            },
            "scale": {
              "type": "integer",
              "minimum": 0,
              "maximum": 38
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "bits"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "float"
            },
            "bits": {
              "enum": [
                32,
                64
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "precision",
            "with_time_zone"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "timestamp"
            },
            "precision": {
              "enum": [
                "s",
                "ms",
                "us",
                "ns"
              ]
            },
            "with_time_zone": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "element"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "list"
            },
            "element": {
              "$ref": "#/$defs/logical_type"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "contract": {
            "enum": ["menura.compiled_plan", "semantic_compiler.compiled_plan"]
          }
        }
      },
      "then": {
        "properties": {
          "sql": {
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "sql": {
            "const": ""
          },
          "parameters": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}