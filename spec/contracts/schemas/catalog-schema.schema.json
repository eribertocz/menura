{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eribertocz.github.io/menura/spec/contracts/catalog-schema/1.1.0",
  "title": "Catalog schema document",
  "type": "object",
  "required": ["contract", "contract_version", "document_id", "engine", "relations"],
  "additionalProperties": false,
  "properties": {
    "contract": {"enum": ["menura.catalog_schema", "semantic_compiler.catalog_schema"]},
    "contract_version": {"$ref": "#/$defs/semver"},
    "document_id": {"$ref": "#/$defs/token"},
    "engine": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}}
  },
  "$defs": {
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "token": {
      "type": "object",
      "required": ["origin", "snapshot"],
      "additionalProperties": false,
      "properties": {
        "origin": {"type": "string", "minLength": 1},
        "snapshot": {"type": "string", "minLength": 1}
      }
    },
    "relation": {
      "type": "object",
      "required": ["source", "columns"],
      "additionalProperties": false,
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "columns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/column"}}
      }
    },
    "column": {
      "type": "object",
      "required": ["name", "logical_type", "physical_type", "nullable"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "logical_type": {"$ref": "#/$defs/logical_type"},
        "physical_type": {"type": "string", "minLength": 1},
        "nullable": {"type": "boolean"}
      }
    },
    "logical_type": {
      "oneOf": [
        {"type": "object", "required": ["kind"], "additionalProperties": false,
         "properties": {"kind": {"enum": ["boolean", "text", "date", "time", "interval", "binary", "uuid", "unsupported"]}}},
        {"type": "object", "required": ["kind", "bits", "signed"], "additionalProperties": false,
         "properties": {"kind": {"const": "integer"}, "bits": {"enum": [8, 16, 32, 64, 128]}, "signed": {"type": "boolean"}}},
        {"type": "object", "required": ["kind", "precision", "scale"], "additionalProperties": false,
         "properties": {"kind": {"const": "decimal"}, "precision": {"type": "integer", "minimum": 1, "maximum": 38}, "scale": {"type": "integer", "minimum": 0, "maximum": 38}}},
        {"type": "object", "required": ["kind", "bits"], "additionalProperties": false,
         "properties": {"kind": {"const": "float"}, "bits": {"enum": [32, 64]}}},
        {"type": "object", "required": ["kind", "precision", "with_time_zone"], "additionalProperties": false,
         "properties": {"kind": {"const": "timestamp"}, "precision": {"enum": ["s", "ms", "us", "ns"]}, "with_time_zone": {"type": "boolean"}}},
        {"type": "object", "required": ["kind", "element"], "additionalProperties": false,
         "properties": {"kind": {"const": "list"}, "element": {"$ref": "#/$defs/logical_type"}}}
      ]
    }
  }
}
