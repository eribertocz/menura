        "enum"
      ],
      "patch": [
        {
          "op": "replace",
          "path": "/metrics/0/kind",
          "value": "window"
        }
      ]
    },
    {
      "name": "no sources in version 1.0.0",
      "valid": true,
      "patch": [
        {
          "op": "replace",
          "path": "/contract_version",
          "value": "1.0.0"
        },
        {
          "op": "remove",
          "path": "/datasets/0/sources"
        },
        {
          "op": "remove",
          "path": "/datasets/1/sources"
        }
      ]
    },
    {
      "name": "dataset without sources in version 1.1.0 (DEP-3.5)",
