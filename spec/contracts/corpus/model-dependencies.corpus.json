{
  "schema": "model-dependencies",
  "example": "model-dependencies.example.json",
  "cases": [
    {
      "name": "published example",
      "valid": true,
      "patch": []
    },
    {
      "name": "unusable metric with its query error code",
      "valid": true,
      "patch": [
        {
          "op": "add",
          "path": "/metrics/0/query_error_code",
          "value": "E0D-05"
        },
        {
          "op": "replace",
          "path": "/metrics/0/usable",
          "value": false
        }
      ]
    },
    {
      "name": "usable entry with a query error code",
      "valid": false,
      "keywords": [
        "not"
      ],
      "patch": [
        {
          "op": "add",
          "path": "/metrics/0/query_error_code",
          "value": "E0D-05"
        }
      ]
    },
    {
      "name": "unusable entry without a query error code",
      "valid": false,
      "keywords": [
        "required"
      ],
      "patch": [
        {
          "op": "replace",
          "path": "/fields/0/usable",
          "value": false
        }
      ]
    },
    {
      "name": "metric without kind",
      "valid": false,
      "keywords": [
        "required"
      ],
      "patch": [
        {
          "op": "remove",
          "path": "/metrics/0/kind"
        }
      ]
    },
    {
      "name": "wrong object kind",
      "valid": false,
      "keywords": [
        "pattern"
      ],
      "patch": [
        {
          "op": "replace",
          "path": "/fields/0/object",
          "value": "metric:CUSTOMER_ID"
        }
      ]
    },
    {
      "name": "short definition hash",
      "valid": false,
      "keywords": [
        "pattern"
      ],
      "patch": [
        {
          "op": "replace",
          "path": "/datasets/0/definition_hash",
          "value": "abc"
        }
      ]
    },
    {
      "name": "unknown member",
      "valid": false,
      "keywords": [
        "additionalProperties"
      ],
      "patch": [
        {
          "op": "add",
          "path": "/extra",
          "value": 1
        }
      ]
    },
    {
      "name": "wrong contract",
      "valid": false,
      "keywords": [
        "const",
        "properties"
      ],
      "patch": [
        {
          "op": "replace",
          "path": "/contract",
          "value": "menura.model_description"
        }
      ]
    },
    {
      "name": "usable is not a boolean",
      "valid": false,
      "keywords": [
        "type",
        "properties",
        "items"
      ],
      "patch": [
        {
          "op": "replace",
          "path": "/datasets/0/usable",
          "value": "yes"
        }
      ]
    },
    {
      "name": "empty query error code",
      "valid": false,
      "keywords": [
        "minLength",
        "if",
        "then",
        "else",
        "not"
      ],
      "patch": [
        {
          "op": "replace",
          "path": "/metrics/0/usable",
          "value": false
        },
        {
          "op": "add",
          "path": "/metrics/0/query_error_code",
          "value": ""
        }
      ]
    },
    {
      "name": "model input of an unknown kind",
      "valid": false,
      "keywords": [
        "items",
        "pattern"
      ],
      "patch": [
        {
          "op": "replace",
          "path": "/metrics/0/model_inputs/0",
