  "sql": "WITH\n  \"home_invoices\" AS (\n    SELECT\n      ROW_NUMBER() OVER () AS \"__row_identity\",\n      \"i\".\"invoice_date\" AS \"invoice_date\",\n      \"i\".\"customer_id\" AS \"customer_id\",\n      \"i\".\"amount\" AS \"amount\"\n    FROM \"sales\".\"public\".\"fact_invoice\" AS \"i\"\n    WHERE \"i\".\"invoice_date\" >= $1\n      AND \"i\".\"invoice_date\" <= $2\n      AND EXISTS (\n        SELECT 1\n        FROM \"sales\".\"public\".\"dim_customer\" AS \"p\"\n        WHERE \"p\".\"customer_id\" = \"i\".\"customer_id\"\n          AND list_contains($3, \"p\".\"region\")\n      )\n  ),\n  \"scan_customers\" AS (\n    SELECT \"c\".\"customer_id\", \"c\".\"region\", \"c\".\"segment\"\n    FROM \"sales\".\"public\".\"dim_customer\" AS \"c\"\n    WHERE list_contains($3, \"c\".\"region\")\n  ),\n  \"joined\" AS (\n    SELECT\n      \"h\".\"__row_identity\",\n      \"c\".\"region\" AS \"region\",\n      CAST(date_trunc('month', \"h\".\"invoice_date\") AS DATE) AS \"invoice_date\",\n      \"h\".\"amount\"\n    FROM \"home_invoices\" AS \"h\"\n    LEFT JOIN \"scan_customers\" AS \"c\"\n      ON \"c\".\"customer_id\" = \"h\".\"customer_id\"\n    WHERE \"c\".\"segment\" = $4\n  ),\n  \"deduplicated\" AS (\n    SELECT DISTINCT ON (\"region\", \"invoice_date\", \"__row_identity\")\n      \"region\", \"invoice_date\", \"amount\"\n    FROM \"joined\"\n  ),\n  \"aggregated\" AS (\n    SELECT\n      \"region\",\n      \"invoice_date\",\n      CAST(SUM(\"amount\") AS DECIMAL(38, 2)) AS \"billed\"\n    FROM \"deduplicated\"\n    GROUP BY \"region\", \"invoice_date\"\n  )\nSELECT \"region\", \"invoice_date\", \"billed\"\nFROM \"aggregated\"\nORDER BY \"billed\" DESC NULLS LAST, \"region\" ASC NULLS LAST, \"invoice_date\" ASC NULLS LAST\nLIMIT 100\n",
